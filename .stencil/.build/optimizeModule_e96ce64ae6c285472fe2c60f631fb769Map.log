{"version":3,"names":["userStatusBulletScss","UserStatusBullet","status","render","h","Host","key","class"],"sources":["src/components/user-status-bullet/user-status-bullet.scss?tag=user-status-bullet&encapsulation=shadow","src/components/user-status-bullet/user-status-bullet.tsx"],"sourcesContent":[":host {\n    display: block;\n    width: 100%;\n    height: 100%;\n}\n\n.status {\n    border-radius: 50%;\n\n    &--offline {\n        background-color: var(---st-grey);\n    }\n\n    &--online {\n        background-color: var(--st-green);\n    }\n\n    &--busy {\n        background-color: var(--st-red);\n    }\n\n    &--away {\n        background-color: var(--st-orange);\n    }\n}","import { Component, Host, Prop, h } from '@stencil/core';\nimport { UserStatus } from './models/user-status';\n\n@Component({\n  tag: 'user-status-bullet',\n  styleUrl: 'user-status-bullet.scss',\n  shadow: true,\n})\nexport class UserStatusBullet {\n  @Prop() status: UserStatus = 'online'\n\n  render() {\n    return (\n      <Host>\n        <div class=\"status w-100 h-100 status--{{ status }}\"></div>\n      </Host>\n    );\n  }\n}\n"],"mappings":"kDAAA,MAAMA,EAAuB,oY,MCQhBC,EAAgB,M,yBACnBC,OAAqB,SAE7B,MAAAC,GACE,OACEC,EAACC,EAAI,CAAAC,IAAA,4CACHF,EAAA,OAAAE,IAAA,2CAAKC,MAAM,4C","ignoreList":[]}